{
  "productName": "幻想镇 3rd",
  "version": "../package.json",
  "identifier": "top.hxzmc.launcher.third",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://127.0.0.1:5178"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "幻想镇 3rd",
        "width": 1250,
        "height": 825,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "local-workspace"
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
