{
  "name": "fantasy-town-next",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "幻想镇 · 全新桌面启动器与服务器官网",
  "scripts": {
    "desktop:dev": "vite --config apps/desktop/vite.config.ts",
    "website:dev": "vite --config apps/website/vite.config.ts",
    "desktop:build": "vite build --config apps/desktop/vite.config.ts && node scripts/build-electron.mjs",
    "desktop:start": ".runtime\\electron\\electron.exe apps/desktop",
    "website:build": "vite build --config apps/website/vite.config.ts && node scripts/build-website.mjs",
    "website:start": "node apps/website/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run desktop:build && npm run website:build",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:legacy": "node scripts/package-legacy.mjs",
    "package:installers": "node scripts/package-installers.mjs",
    "package:server": "node scripts/package-community.mjs"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "1.0.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.4",
    "react-router-dom": "^7.9.0",
    "selfsigned": "3.0.1",
    "sharp": "^0.34.0",
    "undici": "^5.29.0",
    "valtio": "^2.1.0",
    "ws": "8.18.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chess.js": "1.4.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
