# Node.js 24+; copy to .env, then run node --env-file=.env supervisor.mjs
HOST=127.0.0.1
PORT=8787
HXZ_DATA=./data
# Only trust X-Real-IP from a reverse proxy on this machine.
HXZ_TRUST_PROXY=loopback
HXZ_SKIN_API=https://skin.hxzmc.top/api/yggdrasil
# Profile UUIDs from the launcher's account page, comma-separated. Never use a password here.
HXZ_ADMIN_IDS=
# Packaged Electron WebSockets send file://; some opaque requests send null.
# Add specific web origins when deploying behind HTTPS. Do not use a wildcard.
HXZ_ORIGINS=null,file://,http://127.0.0.1:9000,http://localhost:9000
# Voice uses the existing /ws community connection.
# Optional FEC origin process (run `node fec-origin.mjs` beside the service):
# HXZ_FEC_BINARY=./resources/mc-tcp-fec/bin/mc-tcp-fec.exe
# HXZ_FEC_LISTEN=0.0.0.0:40000
# HXZ_FEC_TARGET=127.0.0.1:25565
# HXZ_FEC_TOKEN=change-this-long-random-token
# Configure each of the three default server FEC origins and tokens in the admin server-presets page.
# Community game relay is enabled by default and can be disabled at /api/admin/lobby/relay.

# Optional initial console password (12+ characters). Leave blank to generate a local password file.
HXZ_ADMIN_PASSWORD=
