import org.jetbrains.kotlin.gradle.dsl.JvmTarget

plugins {
    alias(libs.plugins.android.library)
    alias(libs.plugins.kotlin.android)
    alias(libs.plugins.kotlin.serialization)
    alias(libs.plugins.ksp)
}

val repositoryRoot = rootProject.projectDir.resolve("../..").canonicalFile
val fork = providers.gradleProperty("hxzFclSource").orNull?.let { file(it) }
    ?: repositoryRoot.resolve(".runtime/fcl-source/FoldCraftLauncher-efe4dcc5dbc78c55be177c330239e12845ae7ccf")
val prepared = repositoryRoot.resolve(".runtime/embedded-runtime")
check(prepared.resolve("AndroidManifest.xml").isFile) {
    "Run node mobile/game-engine/prepare-embedded.mjs before building the community APK"
}

android {
    namespace = "com.tungsten.fcl"
    compileSdk = 35
    defaultConfig {
        minSdk = 29
        ndk { abiFilters += "arm64-v8a" }
        externalNativeBuild { cmake { arguments("-DANDROID_STL=c++_shared") } }
    }
    buildTypes {
        configureEach {
            resValue("string", "app_version", "HXZ Runtime")
            resValue("string", "curse_api_key", "")
            resValue("string", "oauth_api_key", "")
        }
    }
    sourceSets.getByName("main") {
        manifest.srcFile(prepared.resolve("AndroidManifest.xml"))
        java.srcDir(fork.resolve("FCL/src/main/java"))
        res.srcDir(prepared.resolve("res"))
        assets.srcDir(prepared.resolve("assets"))
        jniLibs.srcDir(prepared.resolve("jniLibs"))
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
        isCoreLibraryDesugaringEnabled = true
    }
    buildFeatures { viewBinding = true; buildConfig = true; resValues = true; prefab = true }
    externalNativeBuild { cmake { path = fork.resolve("FCL/src/main/jni/CMakeLists.txt") } }
    ndkVersion = "30.0.16248370"
    ndkPath = providers.gradleProperty("hxzNdkPath").orNull ?: "E:/hxz_up/hxzup/tools/android-ndk-r30"
    packaging { jniLibs { useLegacyPackaging = true; pickFirsts += "**/libbytehook.so" } }
}
kotlin { compilerOptions { jvmTarget.set(JvmTarget.JVM_17) } }
ksp { arg("room.schemaLocation", layout.buildDirectory.dir("schemas").get().asFile.absolutePath) }

dependencies {
    // Host owns these stripped vendor AARs; compileOnly avoids illegal nesting of local AARs.
