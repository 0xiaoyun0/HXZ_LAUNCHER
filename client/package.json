{
  "name": "hxzl",
  "version": "0.5.0",
  "private": true,
  "description": "幻想镇游戏与社区启动器",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "jingxuanwei <me@jingxuanwei.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "dev:desktop": "quasar dev -m electron",
    "build:desktop": "node scripts/build-installer.cjs && node scripts/ensure-electron.cjs && quasar build -m electron --skip-pkg && node scripts/package-desktop.cjs",
    "build:legacy": "node scripts/ensure-legacy.cjs && node scripts/package-legacy.cjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "electron-updater": "6.8.9",
    "pinia": "^4.0.2",
    "quasar": "^2.31.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6",
    "yauzl": "^3.2.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.8.3",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "packageManager": "pnpm@11.1.2",
  "productName": "幻想镇启动器"
}
