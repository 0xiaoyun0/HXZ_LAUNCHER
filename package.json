{
  "name": "hxz-third",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "幻想镇 3rd · Rust / WebView2 桌面启动器",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "desktop:ui": "vite build --config apps/desktop/vite.config.ts && node scripts/package-community-extension.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "desktop:build": "npm run desktop:ui && npm run worker:build && node scripts/build-native.mjs",
    "build": "npm run desktop:build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "linking:build": "node scripts/build-linking.mjs",
    "website:build": "vite build --config apps/website/vite.config.ts && node scripts/build-website.mjs",
    "website:start": "node apps/website/server/index.mjs",
    "community:start": "node --env-file-if-exists=apps/community-server/.env apps/community-server/supervisor.mjs",
    "package:server": "node scripts/package-community.mjs",
    "assets:sync": "node scripts/restore-runtime.mjs && node scripts/sync-shared.mjs",
    "pretest": "npm run assets:sync",
    "prepackage:server": "npm run assets:prepare",
    "predesktop:ui": "node scripts/restore-runtime.mjs && node scripts/sync-shared.mjs && node scripts/prepare-desktop-assets.mjs",
    "test:engine": "node --test --test-concurrency=1 packages/engine/test/*.test.mjs",
    "test:community": "npm --prefix apps/community-server test",
    "test:native": "cargo test --locked --manifest-path native/Cargo.toml --release",
    "test:desktop": "node scripts/check-native.mjs",
    "test:desktop:layout": "node scripts/check-native.mjs --fixture-account --layout-only",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:installer": "node scripts/package-desktop.mjs --installer",
    "package:website": "npm run website:build && node scripts/package-website.mjs",
    "release:checksums": "node scripts/check-release.mjs",
    "assets:prepare": "npm run assets:sync && node scripts/ensure-linking.mjs",
    "test:packages": "node scripts/check-platforms.mjs",
    "desktop:build:ia32": "npm run desktop:ui && node scripts/build-worker.mjs --ia32 && node scripts/build-native.mjs --ia32",
    "version:check": "node scripts/version-check.mjs",
    "package:bridges": "node scripts/package-bridges.mjs",
    "package:cards": "node scripts/package-cards.mjs",
    "predesktop:build": "npm run version:check",
    "predev": "node scripts/prepare-desktop-assets.mjs"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "1.0.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "default-gateway": "7.2.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "selfsigned": "3.0.1",
    "semver": "7.7.3",
    "sharp": "^0.34.0",
    "three": "0.183.2",
    "undici": "^5.29.0",
    "valtio": "^2.1.0",
    "ws": "8.18.3",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "chess.js": "1.4.0",
    "esbuild": "0.28.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
